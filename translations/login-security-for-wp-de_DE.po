#. Plugin Name of the plugin
#: login-security-for-wp.php
msgid "Login Security – Custom Login URL"
msgstr "Login Security – Eigene Login-URL"

#. Plugin URI of the plugin
#: login-security-for-wp.php
msgid "https://wordpress.org/plugins/login-security-for-wp/"
msgstr ""

#. Description of the plugin
#: login-security-for-wp.php
msgid "Moves the WordPress login to a custom URL of your choice and answers requests to wp-login.php and wp-admin with a regular 404 page."
msgstr "Verlegt den WordPress-Login auf eine URL deiner Wahl und beantwortet Aufrufe von wp-login.php und wp-admin mit einer normalen 404-Seite."

#. Author of the plugin
#: login-security-for-wp.php
msgid "Christian Zimpel"
msgstr ""

#. Author URI of the plugin
#: login-security-for-wp.php
msgid "https://christianzimpel.de"
msgstr ""

#: includes/class-lsfw-admin.php:76
#: includes/class-lsfw-admin.php:77
msgid "Login Security"
msgstr "Login Security"

#: includes/class-lsfw-admin.php:102
msgid "Custom login URL"
msgstr "Eigene Login-URL"

#. translators: %s: login slug
#: includes/class-lsfw-admin.php:127
#, php-format
msgid "\"%s\" is used by WordPress itself. Please choose another login URL."
msgstr "„%s“ wird von WordPress selbst verwendet. Bitte wähle eine andere Login-URL."

#. translators: %s: login slug
#: includes/class-lsfw-admin.php:130
#, php-format
msgid "\"%s\" is already used by a page or post. Please choose another login URL."
msgstr "„%s“ wird bereits von einer Seite oder einem Beitrag verwendet. Bitte wähle eine andere Login-URL."

#: includes/class-lsfw-admin.php:167
msgid "Letters, numbers, hyphens and underscores. Leave empty to switch the protection off."
msgstr "Buchstaben, Zahlen, Binde- und Unterstriche. Leer lassen, um den Schutz auszuschalten."

#: includes/class-lsfw-admin.php:187
msgid "Your login URL:"
msgstr "Deine Login-URL:"

#: includes/class-lsfw-admin.php:189
msgid "Bookmark this address. wp-login.php and /wp-admin/ now answer logged-out visitors with a 404 page."
msgstr "Setz dir ein Lesezeichen. wp-login.php und /wp-admin/ zeigen nicht angemeldeten Besuchern jetzt eine 404-Seite."

#: includes/class-lsfw-admin.php:193
msgid "The protection is off. Choose a login URL below to activate it."
msgstr "Der Schutz ist aus. Wähle unten eine Login-URL, um ihn zu aktivieren."

#: includes/class-lsfw-admin.php:205
msgid "Good to know"
msgstr "Gut zu wissen"

#: includes/class-lsfw-admin.php:207
msgid "A hidden login reduces automated attacks and log noise. It is not a replacement for strong passwords, two-factor authentication or a limit on login attempts – combine them."
msgstr "Ein versteckter Login reduziert automatisierte Angriffe und Log-Rauschen. Er ersetzt keine starken Passwörter, keine Zwei-Faktor-Authentifizierung und keine Begrenzung der Login-Versuche – kombiniere sie."

#. translators: %s: PHP code
#: includes/class-lsfw-admin.php:212
#, php-format
msgid "Locked out? Add %s to wp-config.php or rename the plugin folder via FTP. The normal login works again immediately."
msgstr "Ausgesperrt? Füge %s in die wp-config.php ein oder benenne den Plugin-Ordner per FTP um. Der normale Login funktioniert dann sofort wieder."

#: includes/class-lsfw-admin.php:237
msgid "Login Security is active but no custom login URL is set yet."
msgstr "Login Security ist aktiv, aber es ist noch keine eigene Login-URL festgelegt."

#: includes/class-lsfw-admin.php:239
msgid "Set it now"
msgstr "Jetzt festlegen"

#: includes/class-lsfw-admin.php:267
msgid "Settings"
msgstr "Einstellungen"

#: includes/class-lsfw-plugin.php:314
msgid "The page you are looking for does not exist."
msgstr "Die gesuchte Seite existiert nicht."

#: includes/class-lsfw-plugin.php:315
msgid "Page not found"
msgstr "Seite nicht gefunden"

#: includes/class-lsfw-plugin.php:319
msgid "Go to the homepage"
msgstr "Zur Startseite"
