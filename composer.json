{
	"name": "christianzimpel/login-security-for-wp",
	"description": "Moves the WordPress login to a custom URL and answers wp-login.php and wp-admin with a real 404 page.",
	"type": "wordpress-plugin",
	"license": "GPL-3.0-or-later",
	"authors": [
		{
			"name": "Christian Zimpel",
			"homepage": "https://christianzimpel.de"
		}
	],
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.1"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"format": "phpcbf"
	}
}
